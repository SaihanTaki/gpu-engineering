{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@sims/*": ["src/sims/*"],
      "@sim-core/*": ["src/sim-core/*"],
      "@kernels/*": ["../kernels/*"]
    }
  }
}
