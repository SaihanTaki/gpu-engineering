---
import type { Question } from '../quizzes/types';

interface Props {
	questions: Question[];
}

const { questions } = Astro.props;
const id = `quiz-${Math.random().toString(36).slice(2, 8)}`;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const md = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');
---

<div class="quiz not-content" data-quiz>
	<p class="quiz-score" aria-live="polite" data-quiz-score>
		{questions.length} questions. Pick an answer to see if it is right.
	</p>
	<ol>
		{
			questions.map((item, i) => (
				<li>
					<fieldset data-answer={item.answer}>
						<legend set:html={`${i + 1}. ${md(item.q)}`} />
						{item.options.map((opt, j) => (
							<label>
								<input type="radio" name={`${id}-${i}`} value={j} />
								<span set:html={md(opt)} />
							</label>
						))}
						<p class="quiz-feedback" aria-live="polite" hidden>
							<strong data-verdict />{' '}
							<span set:html={md(item.why)} />
						</p>
					</fieldset>
				</li>
			))
		}
	</ol>
</div>

<script>
	for (const quiz of document.querySelectorAll<HTMLElement>('[data-quiz]')) {
		const sets = [...quiz.querySelectorAll<HTMLFieldSetElement>('fieldset')];
		const score = quiz.querySelector<HTMLElement>('[data-quiz-score]')!;
		const update = () => {
			const done = sets.filter((s) => s.dataset.picked !== undefined);
			const right = done.filter((s) => s.dataset.picked === s.dataset.answer).length;
			score.textContent = `${right} of ${done.length} answered correctly, ${sets.length - done.length} left.`;
		};
		for (const set of sets) {
			set.addEventListener('change', (e) => {
				const input = e.target as HTMLInputElement;
				set.dataset.picked = input.value;
				const ok = input.value === set.dataset.answer;
				for (const label of set.querySelectorAll('label')) {
					const v = label.querySelector('input')!.value;
					label.classList.toggle('is-correct', v === set.dataset.answer);
					label.classList.toggle('is-wrong', v === input.value && !ok);
				}
				const fb = set.querySelector<HTMLElement>('.quiz-feedback')!;
				fb.querySelector('[data-verdict]')!.textContent = ok ? 'Correct.' : 'Not quite.';
				fb.hidden = false;
				update();
			});
		}
	}
</script>

<style>
	.quiz ol {
		list-style: none;
		padding-left: 0;
		margin: 1rem 0 0;
	}
	.quiz li + li {
		margin-top: 1.25rem;
	}
	.quiz fieldset {
		border: 0;
		padding: 0;
		margin: 0;
		min-width: 0;
	}
	.quiz legend {
		max-width: 100%;
		overflow-wrap: anywhere;
		font-weight: 600;
		padding: 0;
		margin-bottom: 0.5rem;
		color: var(--sl-color-white);
	}
	.quiz label {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		min-height: 44px;
		padding: 0.55rem 0.75rem;
		margin-top: 0.35rem;
		border: 1px solid var(--sim-line);
		border-radius: 0.375rem;
		cursor: pointer;
		overflow-wrap: anywhere;
	}
	.quiz label:hover {
		border-color: var(--sl-color-accent);
	}
	.quiz input {
		margin-top: 0.3rem;
		flex: none;
		accent-color: var(--sl-color-accent);
	}
	.quiz input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.quiz label.is-correct {
		border-color: var(--sim-active);
		background: var(--sim-code-active);
	}
	.quiz label.is-correct::after {
		content: 'Correct answer';
		margin-left: auto;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
	.quiz label.is-wrong {
		border-color: var(--sim-warn);
		background: var(--sim-warn-fill);
	}
	.quiz label.is-wrong::after {
		content: 'Your answer';
		margin-left: auto;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		white-space: nowrap;
	}
	/* Long metric names in `code` must wrap at phone width. */
	.quiz label span,
	.quiz-feedback {
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.quiz-feedback {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-2);
	}
	.quiz-score {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.quiz code {
		font-family: var(--sl-font-mono);
		font-size: 0.9em;
	}
</style>
