---
import SimFrame from '@components/SimFrame.astro';
import { GPUS } from '@sim-core/gpu-specs';
import { CHUNK_COUNTS, CODE, DEFAULTS, KERNEL_RATIOS, OVERHEAD_US, SIZES_MIB, STREAM_COUNTS } from './model';

interface Props {
	gpu?: (typeof GPUS)[number]['id'];
}

const { gpu = 'a100' } = Astro.props;
const d = DEFAULTS;
const code = [
	{ name: 'pinned', code: CODE.pinned, lang: 'cpp' },
	{ name: 'pageable', code: CODE.pageable, lang: 'cpp' },
];
---

<SimFrame title="Stream timeline: copy in, compute, copy out, in chunks" sim="stream-timeline" code={code} config={{ gpu, ...d }}>
	<Fragment slot="params">
		<label class="sim-field">
			<span>Streams (NSTREAMS)</span>
			<select name="streams">
				{STREAM_COUNTS.map((n) => <option value={n} selected={n === d.streams}>{n}</option>)}
			</select>
		</label>
		<label class="sim-field">
			<span>Chunks (NCHUNKS)</span>
			<select name="chunks">
				{CHUNK_COUNTS.map((n) => <option value={n} selected={n === d.chunks}>{n}</option>)}
			</select>
		</label>
		<label class="sim-field">
			<span>Data size</span>
			<select name="mib">
				{SIZES_MIB.map((n) => <option value={n} selected={n === d.mib}>{n} MiB</option>)}
			</select>
		</label>
		<label class="sim-field">
			<span>Kernel time per chunk</span>
			<select name="kernelRatio">
				{KERNEL_RATIOS.map((r) => <option value={r} selected={r === d.kernelRatio}>{r} x the chunk's H2D copy</option>)}
			</select>
		</label>
		<label class="sim-field">
			<span>Host memory</span>
			<select name="pinned">
				<option value="1" selected>Pinned (cudaMallocHost)</option>
				<option value="0">Pageable (malloc)</option>
			</select>
		</label>
		<label class="sim-field">
			<span>Copy engines</span>
			<select name="engines">
				<option value="2" selected>2, one per direction</option>
				<option value="1">1, shared by both directions</option>
			</select>
		</label>
		<label class="sim-field">
			<span>Fixed cost per operation (assumed)</span>
			<select name="overheadUs">
				{OVERHEAD_US.map((u) => <option value={u} selected={u === d.overheadUs}>{u} µs</option>)}
			</select>
		</label>
		<label class="sim-field">
			<span>GPU</span>
			<select name="gpu">
				{GPUS.map((g) => <option value={g.id} selected={g.id === gpu}>{g.name}, PCIe Gen{g.pcieGen}</option>)}
			</select>
		</label>
	</Fragment>

	<p class="st-link" data-link></p>
	<div class="sim-canvas" data-canvas>
		<svg role="img" aria-label="Gantt chart: one row per stream, then one row per engine, then the serial run, on a shared time axis"></svg>
	</div>

	<ul class="st-legend" aria-label="Legend">
		<li><span class="sim-swatch st-sw-h2d"></span>H: H2D copy</li>
		<li><span class="sim-swatch st-sw-kernel"></span>K: kernel</li>
		<li><span class="sim-swatch st-sw-d2h"></span>D: D2H copy</li>
		<li><span class="sim-swatch st-sw-future"></span>not run yet</li>
	</ul>
	<ul class="st-totals" data-totals aria-label="Totals, model estimates"></ul>

	<Fragment slot="caption">
		Model estimates. Copies run at the per-direction PCIe peak for the chosen GPU, a lower bound. One kernel runs at a
		time, and an operation starts when the one before it in its stream has finished and its engine is free. Two values
		are assumptions, because NVIDIA does not publish them: the fixed cost per operation you pick, and a pageable copy
		that pays a staging copy at the PCIe rate and overlaps with nothing. Real GPUs may have more copy engines, run
		kernels from different streams at once, and reorder work in ways this model does not.
	</Fragment>
</SimFrame>

<script>
	import { Stepper } from '@sim-core/stepper';
	import { bindControls } from '@sim-core/controls';
	import { highlightLines, showVariant } from '@sim-core/code-sync';
	import { gpuById } from '@sim-core/gpu-specs';
	import { chunkBytes, copySeconds, describe, fmtMiB, fmtTime, fmtX, lastStep, stateAt, summary, type Params } from './model';
	import { render } from './view';

	function mount(frame: HTMLElement) {
		const config = JSON.parse(frame.dataset.config!);
		const sel = (name: string) => frame.querySelector<HTMLSelectElement>(`select[name="${name}"]`)!;
		const read = (): Params => ({
			gpu: gpuById(sel('gpu').value),
			streams: Number(sel('streams').value),
			chunks: Number(sel('chunks').value),
			mib: Number(sel('mib').value),
			kernelRatio: Number(sel('kernelRatio').value),
			pinned: sel('pinned').value === '1',
			engines: sel('engines').value === '1' ? 1 : 2,
			overheadUs: Number(sel('overheadUs').value),
		});
		sel('gpu').value = config.gpu;
		let p = read();
		const stepper = new Stepper(lastStep(p), 900);
		const canvas = frame.querySelector<HTMLElement>('[data-canvas]')!;
		const svgEl = canvas.querySelector('svg')!;
		const totalsEl = frame.querySelector<HTMLElement>('[data-totals]')!;
		const linkEl = frame.querySelector<HTMLElement>('[data-link]')!;
		let code = showVariant(frame, p.pinned ? 'pinned' : 'pageable');

		const item = (s: string) => {
			const li = document.createElement('li');
			li.textContent = s;
			return li;
		};
		const draw = () => {
			const st = stateAt(p, stepper.step);
			render(svgEl, p, st, Math.max(260, canvas.clientWidth));
			highlightLines(code, st.lines);
			const sm = summary(p);
			const c = chunkBytes(p)[0];
			linkEl.textContent = `PCIe Gen${p.gpu.pcieGen} x16, ${p.gpu.pcieGbPerS} GB/s each way (peak, from the GPU preset). One ${fmtMiB(c)} chunk: copy ${fmtTime(copySeconds(p.gpu, c) * (p.pinned ? 1 : 2))}${p.pinned ? '' : ' with staging'}, kernel ${fmtTime(p.kernelRatio * copySeconds(p.gpu, c))}, plus ${p.overheadUs} µs each.`;
			totalsEl.replaceChildren(
				item(`This run: ${fmtTime(sm.total)}`),
				item(`Serial (one chunk, one stream): ${fmtTime(sm.serial)}`),
				item(`Speedup: ${fmtX(sm.speedup)}`),
				item(`Busiest engine alone: ${fmtTime(sm.bound)}`),
			);
		};

		frame.querySelector('.sim-params')!.addEventListener('change', () => {
			p = read();
			code = showVariant(frame, p.pinned ? 'pinned' : 'pageable');
			stepper.setLast(lastStep(p));
		});

		bindControls(frame, stepper, (step) => describe(p, step));
		stepper.onChange(draw);
		new ResizeObserver(draw).observe(canvas);
		draw();
	}

	document.querySelectorAll<HTMLElement>('[data-sim="stream-timeline"]').forEach(mount);
</script>
